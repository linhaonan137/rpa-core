{
  "name": "端到端示例：循环 + 变量 + 数据落盘",
  "version": 1,
  "vars": [
    {
      "name": "rows",
      "value": []
    }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "set_var",
      "args": {
        "name": "rows",
        "value": []
      },
      "label": "初始化空列表",
      "on_fail": {
        "mode": "skip"
      }
    },
    {
      "id": "n2",
      "type": "loop",
      "args": {
        "kind": "count",
        "count": 3
      },
      "label": "循环 3 轮"
    },
    {
      "id": "n3",
      "type": "set_var",
      "args": {
        "name": "item",
        "value": "第 {_index} 条"
      },
      "label": "造一条数据"
    },
    {
      "id": "n4",
      "type": "noop",
      "args": {},
      "label": "占位：真实场景这里是点击/抓取"
    },
    {
      "id": "n5",
      "type": "data_sheet_write",
      "args": {
        "path": "out/demo.xlsx",
        "sheet": "数据",
        "rows": [
          {
            "序号": 1,
            "说明": "循环结束后写表"
          }
        ]
      },
      "label": "写 Excel",
      "on_fail": {
        "mode": "skip"
      },
      "_note": "缺 openpyxl 时跳过，不影响整条链跑通"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "n1",
      "to": "n2"
    },
    {
      "id": "e2",
      "from": "n2",
      "to": "n3",
      "exit": "loop"
    },
    {
      "id": "e3",
      "from": "n3",
      "to": "n4"
    },
    {
      "id": "e4",
      "from": "n4",
      "to": "n2"
    },
    {
      "id": "e5",
      "from": "n2",
      "to": "n5",
      "exit": "done"
    }
  ]
}