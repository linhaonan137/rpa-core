      "label": "末尾业务断言：主图5张 + 属性5个有值",
      "args": {
        "code": "() => {\n  const imgs = document.querySelectorAll('.sell-component-simply-images img').length;\n  const names = ['版型分类', '面料', '上市年份季节', '袖长类型', '适用性别'];\n  let filled = 0;\n  for (const nm of names) {\n    const lab = [...document.querySelectorAll('span.sell-component-info-wrapper-label')]\n      .find(e => (e.innerText || '').trim() === nm);\n    if (!lab) continue;\n    const box = lab.closest('.sell-component-info-wrapper-wrap');\n    if (!box) continue;\n    const inp = box.querySelector('input');\n    const sel = box.querySelector('.next-select-values');\n    const v = (inp && inp.value) ? inp.value : (sel ? (sel.innerText || '').trim() : '');\n    if (v && v.indexOf('请选择') < 0 && v.indexOf('请输入') < 0) filled++;\n  }\n  if (imgs < 5 || filled < 5) {\n    throw new Error('业务断言失败: 主图=' + imgs + ' 属性已填=' + filled);\n  }\n  return '主图=5 属性=5';\n}"
      },
      "id": "n70"
    }
