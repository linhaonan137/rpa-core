      "args": {
        "code": "async () => {\n  const sleep = (ms) => new Promise(r => setTimeout(r, ms));\n  const btn = [...document.querySelectorAll('button')]\n    .find(b => (b.innerText || '').trim() === '完成');\n  if (btn) { btn.click(); await sleep(1200); }\n  const card = document.querySelector('[class*=pic_imgBox]');\n  if (!card) return 'no-card';\n  const r = card.getBoundingClientRect();\n  ['mouseover', 'mouseenter', 'mousemove'].forEach(function (t) {\n    card.dispatchEvent(new MouseEvent(t, { bubbles: true, clientX: r.x + 5, clientY: r.y + 5 }));\n  });\n  await sleep(350);\n  const cb = document.querySelector('.PicList_checkbox__769at');\n  if (cb) { cb.click(); await sleep(300); }\n  const inp = cb ? cb.querySelector('input') : null;\n  return { checked: inp ? inp.getAttribute('aria-checked') : 'clicked-card' };\n}",
        "jitter": [
          400,
          800
        ]
