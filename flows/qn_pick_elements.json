        "code": "() => { const n = '{品牌}'.trim(); const els = [...document.querySelectorAll('div.options-item')].filter(e => (e.innerText||'').trim() === n); if (!els.length) throw new Error('品牌列表里没有: ' + n); els[0].click(); return n; }",
        "jitter": [
          300,
          800
        ]
      },
      "off": false
    },
