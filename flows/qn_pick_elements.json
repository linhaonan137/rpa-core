{
  "name": "千牛发品元素拾取（录制即入元素库，拾取后立刻用 @el: 引用）",
  "version": 1,
  "nodes": [
    {
      "id": "n1",
      "type": "web_open",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "jitter": [
          500,
          1500
        ],
        "until": "dom",
        "url": "https://myseller.taobao.com/home.htm/QnworkbenchHome/"
      },
      "off": false
    },
    {
      "id": "n2",
      "type": "web_wait",
      "args": {
        "target": "a:has-text('商品')",
        "kind": "visible",
        "limit_ms": 15000,
        "jitter": [
          300,
          800
        ]
      }
    },
    {
      "id": "n3",
      "type": "web_pick",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "key": "qn_goods_menu",
        "target": "a:has-text('商品')"
      },
      "off": false
    },
    {
      "id": "n4",
      "type": "web_click",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "jitter": [
          300,
          800
        ],
        "target": "@el:qn_goods_menu"
      },
      "off": false
    },
    {
      "id": "n5",
      "type": "web_pick",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "key": "qn_publish_link",
        "target": "a:has-text('发布商品')"
      },
      "off": false
    },
    {
      "id": "n6",
      "type": "web_js",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "code": "() => { const a = [...document.querySelectorAll('a')].find(e => (e.innerText||'').trim() === '发布商品'); if (!a) throw new Error('找不到发布商品链接'); a.click(); return a.href; }"
      },
      "off": false
    },
    {
      "id": "n7",
      "type": "sleep",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "ms": [
          1200,
          2200
        ]
      },
      "off": false
    },
    {
      "id": "n8",
      "type": "web_tab",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "jitter": [
          400,
          1000
        ],
        "kind": "title",
        "match": "contains",
        "title": "商品发布"
      },
      "off": false
    },
    {
      "id": "n9",
      "type": "web_wait",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "jitter": [
          400,
          1000
        ],
        "limit_ms": 20000,
        "text": "{一级类目}"
      },
      "off": false
    },
    {
      "id": "n10",
      "type": "web_js",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "code": "() => { const n = '{一级类目}'.trim(); const el = [...document.querySelectorAll('p,span,li')].find(e => (e.innerText||'').trim() === n && e.getBoundingClientRect().width > 0); if (!el) throw new Error('找不到一级类目: ' + n); el.click(); return n; }",
        "jitter": [
          300,
          800
        ]
      },
      "off": false
    },
    {
      "id": "n11",
      "type": "web_wait",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "jitter": [
          300,
          800
        ],
        "limit_ms": 15000,
        "text": "{二级类目}"
      },
      "off": false
    },
    {
      "id": "n12",
      "type": "web_js",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "code": "() => { const n = '{二级类目}'.trim(); const el = [...document.querySelectorAll('li,p,span')].find(e => (e.innerText||'').trim() === n && e.getBoundingClientRect().width > 0); if (!el) throw new Error('找不到二级类目: ' + n); el.click(); return n; }",
        "jitter": [
          300,
          800
        ]
      },
      "off": false
    },
    {
      "id": "n13",
      "type": "web_wait",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
