      "id": "n5",
      "type": "web_js",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "args": {
        "code": "() => { const a = [...document.querySelectorAll('a')].find(e => (e.innerText||'').trim() === '发布商品'); if (!a) throw new Error('找不到发布商品链接'); a.click(); return a.href; }"
      },
      "label": "②点发布商品（浮层遮挡）",
      "off": false,
      "budget_ms": 0
    },
    {
      "id": "n6",
      "type": "sleep",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
