          900
        ],
        "kind": "visible",
        "limit_ms": 20000,
        "target": "a:has-text('商品')"
      },
      "label": "等工作台渲染（等商品菜单出现）",
      "off": false,
      "budget_ms": 0
    },
    {
      "id": "n3",
      "type": "web_click",
      "position": {
        "x": 0.0,
        "y": 0.0
