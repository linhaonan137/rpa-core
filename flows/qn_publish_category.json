          1200,
          2200
        ]
      },
      "label": "等新标签开出来（这里没元素可等，用区间）",
      "off": false,
      "budget_ms": 0
    },
    {
      "id": "n7",
      "type": "web_tab",
      "position": {
        "x": 0.0,
