{
  "name": "真实站点验证 2：百度 AI 搜索全链路",
  "version": 1,
  "vars": [{"name": "keyword", "value": "RPA 自动化"}],
  "nodes": [
    {"id": "n1", "type": "web_open", "args": {"url": "https://www.baidu.com", "until": "dom", "limit_ms": 45000, "headless": false}, "label": "打开百度"},
    {"id": "n15", "type": "web_wait", "args": {"target": "#chat-textarea", "state": "attached", "limit_ms": 30000}, "label": "等 AI 输入框渲染"},
    {"id": "n2", "type": "web_type", "args": {"target": "#chat-textarea", "value": "{keyword}", "kind": "press", "delay_ms": 60, "limit_ms": 20000}, "label": "输入搜索词"},
    {"id": "n3", "type": "web_click", "args": {"target": "#chat-submit-button", "limit_ms": 20000, "follow_new_tab": true}, "label": "点百度一下"},
    {"id": "n4", "type": "wait", "args": {"ms": 6000}, "label": "等 AI 结果渲染"},
    {"id": "n5", "type": "web_shot", "args": {"path": "out/real_baidu2.png"}, "label": "截图存证"},
    {"id": "n6", "type": "web_js", "args": {"code": "() => document.body.innerText.length", "save_as": "page_len"}, "label": "页面文本量"},
    {"id": "n7", "type": "web_close", "args": {"kind": "all"}, "label": "收尾"}
  ],
  "edges": [
    {"id": "e1", "from": "n1", "to": "n2"},
    {"id": "e2", "from": "n2", "to": "n3"},
    {"id": "e3", "from": "n3", "to": "n4"},
    {"id": "e4", "from": "n4", "to": "n5"},
    {"id": "e5", "from": "n5", "to": "n6"},
    {"id": "e6", "from": "n6", "to": "n7"}
  ]
}
